                "textRuns": [
                  {
                    "value": "Après un pic à 5,5K ventes en 2017, le volume recule jusqu’en 2023, où il est presque divisé par deux en un an, au moment de la remontée des taux d’intérêt. ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "Les prix suivent avec un décalage : l’existant culmine en 2022, la VEFA en 2023. ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "Depuis 2024, les ventes repartent, sans retrouver leur niveau d’avant 2022. ",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "indent": 1
              },
              {
                "textRuns": [
                  {
                    "value": "Sur la période, Luxembourg-Ville reste la commune la plus chère.",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  }
                ],
                "indent": 1
              }
            ]
